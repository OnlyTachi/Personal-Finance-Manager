# ==========================================
# CONFIGURAÇÕES GERAIS
# ==========================================
PROJECT_NAME="Personal Finance Manager"
API_V1_STR="/api/v1"
SECRET_KEY="sua_chave_secreta_super_segura_aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 dias

# ==========================================
# BANCO DE DADOS
# ==========================================
# Para execução local sem Docker, descomente e ajuste o caminho se necessário:
# DATABASE_URL="sqlite:///./investimentos.db"
DATABASE_URL="sqlite:////app/investimentos.db"

# ==========================================
# BOTS (TELEGRAM & DISCORD)
# ==========================================
TELEGRAM_BOT_TOKEN="seu_token_do_botfather"
DISCORD_BOT_TOKEN="seu_token_do_discord_developer_portal"
# Preencha se estiver usando Webhook em produção (ex: https://seu-dominio.com)
WEBHOOK_DOMAIN=""

# ==========================================
# SMTP (ENVIO DE RELATÓRIOS POR E-MAIL)
# ==========================================
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu_email@gmail.com"
SMTP_PASSWORD="sua_senha_de_aplicativo_google"

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (IA / SLM / LLM)
# ==========================================
# Tier 1: Gemini (Nuvem - Rápido para leitura de recibos OCR)
GEMINI_API_KEY="sua_chave_google_gemini"

# Tier 2: Ollama Remoto (Máquina potente / GPU via Tailscale ou VPN)
OLLAMA_WORKER_URL="http://ip_da_maquina_remota:11434"
OLLAMA_WORKER_MODEL="qwen2.5:3b"

# Tier 3: Ollama Local (Fallback no próprio servidor)
OLLAMA_LOCAL_URL="http://localhost:11434"
OLLAMA_LOCAL_MODEL="qwen2.5:3b"